<UserControl x:Class="UnrealManager.Views.LogConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#12141A" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,8">
                <TextBlock Text="Output Log" FontFamily="Segoe UI Semibold" Foreground="{StaticResource MutedBrush}"/>
                <Button Content="Clear" HorizontalAlignment="Right" Padding="10,3" FontSize="11"
                        Click="OnClear" Margin="0"/>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Padding="12,0,12,10">
                <TextBox x:Name="Output" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="#C7D0DE" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
